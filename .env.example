# Optional locally. Required on Vercel so every phone in the room
# sees the same queue (serverless instances do not share memory).
#
# Create a free Redis database at https://upstash.com
# then paste the REST credentials here.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel KV / Upstash Marketplace uses these names instead.
# Either pair works.

# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Optional song search enrichments ---
# Search always fills title, artist, a language guess, and YouTube/Spotify
# search-page links (no keys). Add these only if you want exact watch/track URLs:

# YouTube Data API v3 key → exact karaoke watch URL on the top search hit
# YOUTUBE_API_KEY=

# Spotify app Client Credentials → exact Spotify track links in search results
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
