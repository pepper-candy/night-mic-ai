# Optional locally. Required on Vercel so every phone in the room
# sees the same queue (serverless instances do not share memory).
#
# Create a free Redis database at https://upstash.com
# then paste the REST credentials here.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel KV / Upstash Marketplace uses these names instead.
# Either pair works.

# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Optional song search enrichments ---
# Title + artist search always works via Apple's free iTunes Search API.
# Add these if you want autofill to also attach streaming links:

# YouTube Data API v3 key → fills a karaoke YouTube link on the top search hit
# YOUTUBE_API_KEY=

# Spotify app Client Credentials → fills Spotify track links in search results
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
