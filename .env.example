# Optional locally. Required on Vercel so every phone in the room
# sees the same queue (serverless instances do not share memory).
#
# Create a free Redis database at https://upstash.com
# then paste the REST credentials here.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel KV / Upstash Marketplace uses these names instead.
# Either pair works.

# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- YouTube Data API v3 (server-only) ---
# Required for the explicit "Find link" button on add/edit song.
# Never used while typing a title. Each Find ≈ 100 (search.list) + ~1
# (videos.list) quota units; default 10,000/day ≈ 100 finds.
# 1. Google Cloud Console → create/select a project
# 2. Enable YouTube Data API v3
# 3. Create an API key (restrict it to that API if you can)
# 4. Paste the key here and in the Vercel project environment
# The key is used only in /api/youtube/search — never sent to the browser.
# Without it, guests can still paste a YouTube URL.

YOUTUBE_API_KEY=

# Spotify app Client Credentials → exact Spotify track links in search results
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
