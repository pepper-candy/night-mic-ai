# Optional locally. Required on Vercel so every phone in the room
# sees the same queue (serverless instances do not share memory).
#
# Create a free Redis database at https://upstash.com
# then paste the REST credentials here.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel KV / Upstash Marketplace uses these names instead.
# Either pair works.

# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Song search (optional upgrades) ---
# Title + artist search ALWAYS works (Apple iTunes, no key).
# Without the keys below, picking a search result still fills:
#   YouTube → youtube.com/results?search_query=<song> karaoke
#   Spotify → open.spotify.com/search/<song>
# With keys, those become a specific watch URL / track URL (needed for
# embedded cohost preview).
#
# Local: copy this file to .env.local and fill the values, then restart
# `npm run dev`. Production: Vercel → Project → Settings → Environment
# Variables → add the same names → Redeploy.
#
# YouTube Data API v3 (Google Cloud Console)
# 1. https://console.cloud.google.com/ → create a project
# 2. APIs & Services → Library → enable "YouTube Data API v3"
# 3. APIs & Services → Credentials → Create credentials → API key
# 4. Restrict the key to YouTube Data API v3
# YOUTUBE_API_KEY=
#
# Spotify Client Credentials
# 1. https://developer.spotify.com/dashboard → log in → Create app
# 2. Redirect URI can be http://localhost:3847 (not used for search)
# 3. Copy Client ID and Client Secret
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
